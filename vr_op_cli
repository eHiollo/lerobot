import json
from collections import Counter
from pathlib import Path

path = Path(
    "/home/robot/VLA/lerobot/outputs/vr_diagnostics/vr_only_test_01.jsonl"
)
rows = [
    json.loads(line)
    for line in path.read_text(encoding="utf-8").splitlines()
    if line.strip()
]

print("总记录数:", len(rows))
print("过滤原因:")
for reason, count in Counter(r.get("guard_reason") for r in rows).most_common():
    print(f"  {reason}: {count}")

ages = [r["sample_age_s"] for r in rows if r.get("sample_age_s") is not None]
print("最大 sample age:", max(ages, default=None))

sequences = [r["diagnostics_record_sequence"] for r in rows]
missing = sum(b - a - 1 for a, b in zip(sequences, sequences[1:]) if b > a + 1)
print("诊断序号缺失数:", missing)
PY

